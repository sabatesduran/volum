    "@volum/shared": "file:../../packages/shared",
    "@volum/viewer": "file:../../packages/viewer",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-query": "^5.90.2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-barcode-scanner": "^2.5.3",
