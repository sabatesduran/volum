  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        }
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiError"
          }
        }
      },
      "ServerIdentity": {
        "type": "object",
        "required": [
          "serverId",
          "name",
          "protocolMin",
          "protocolMax"
        ],
        "properties": {
          "serverId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "protocolMin": {
            "type": "integer"
          },
          "protocolMax": {
            "type": "integer"
          }
        }
      },
      "PairResponse": {
        "type": "object",
        "required": [
          "serverId",
          "deviceId",
          "token",
          "protocolVersion"
        ],
        "properties": {
          "serverId": {
            "type": "string"
          },
          "deviceId": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "protocolVersion": {
            "type": "integer"
          }
        }
      },
      "ServerCapabilities": {
        "type": "object",
        "required": [
          "readLibrary",
          "organizationWrites",
          "photoUploads",
          "fileUploads",
          "viewerMeshes",
          "plateThumbnails",
          "costEstimates",
          "relatedProjects",
          "liveEvents"
        ],
        "properties": {
          "readLibrary": {
            "type": "boolean"
          },
          "organizationWrites": {
            "type": "boolean"
          },
          "photoUploads": {
            "type": "boolean",
            "description": "Whether the host currently permits project-photo uploads. This policy is independent of organization writes."
          },
          "fileUploads": {
            "type": "boolean",
            "description": "Whether the host currently permits managed 3D-file imports."
          },
          "viewerMeshes": {
            "type": "boolean"
          },
          "plateThumbnails": {
            "type": "boolean"
          },
          "costEstimates": {
            "type": "boolean"
          },
          "relatedProjects": {
